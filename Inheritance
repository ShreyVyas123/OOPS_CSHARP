using System;

class Animal                     
{
    public string Name { get; set; }

    public void Eat()
    {
        Console.WriteLine($"{Name} is eating");
    }
}

class Dog : Animal            
{
    public void Bark()
    {
        Console.WriteLine($"{Name} says Woof");
    }
}

class Cat : Animal
{
    public void Meow()
    {
        Console.WriteLine($"{Name} says Meow");
    }
}

class Program
{
    static void Main()
    {
        Dog d = new Dog();
        d.Name = "Tommy";    
        d.Eat();             
        d.Bark();            

        Cat c = new Cat();
        c.Name = "Kitty";
        c.Eat();             
        c.Meow();           
    }
}
