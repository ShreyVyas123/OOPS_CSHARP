using System;

class Animal{
    public virtual void Sound(){
        Console.WriteLine("Animal makes a sound");
    }
}

class Dog : Animal{
    public override void Sound(){
        Console.WriteLine("Dog barks");
    }
}

class Cat : Animal{
    public override void Sound(){
        Console.WriteLine("Cat meows");
    }
}

class Program{
    static void Main(){
        Animal a1 = new Dog();
        Animal a2 = new Cat();
        Animal a3 = new Animal();

        a1.Sound();
        a2.Sound();
        a3.Sound();
    }
}
