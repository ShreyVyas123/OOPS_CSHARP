using System;

class Calculation{
    public void Add(int a , int b){
        Console.WriteLine(a+b);
    }
    
    public void Add(int a , int b , int c){
        Console.WriteLine(a+b+c);
    }
    public void Add(double a , double b){
        Console.WriteLine(a+b);
    }
}

class Program{
    static void Main(){
        Calculation c1 = new Calculation();
        
        c1.Add(2,5);
        c1.Add(2,5,3);
        c1.Add(10.0,7.0);
    }
}
