#PUBLIC

using System;

class Car{
    public string name = "Koinegsegg";
    public void display(){
        Console.WriteLine(name);
    }
}

class Program{
    static void Main(){
        Car c1 = new Car();
        c1.display();
    }
}


#PRIVATE

using System;

class Student{
    private int age = 22;
    
    public void display(){
        Console.WriteLine(age);
        
    }
}

class Program{
    static void Main(){
        Student s1 = new Student();
        s1.display();
    }
}


#PROTECTED

using System;

class University{
    protected string name = "Alliance";
}

class Student:University{
    public void display(){
        Console.WriteLine(name);
    }
}


class Program{
    static void Main(){
        Student s1 = new Student();
        s1.display();
    }
}



#INTERNAL

using System;

class Student{
    internal string college = "Alliance University";
}

class Program{
    static void Main(){
        Student s1 = new Student();
        Console.WriteLine(s1.college);
    }
}
