class BankAccount{
    private string accholder;
    private double balance;
    
    public void SetData(string a , double b){
        accholder = a;
        balance = b;
    }
    
    public void Deposit(double amount){
        Console.WriteLine(amount + balance);
    }
    
    public void Withdraw(double amount){
        if(amount > balance){
            Console.WriteLine("Insufficient Bank Balance...");
        }
        else{
            Console.WriteLine(balance - amount);
        }
    }
    
    class Program{
        static void Main(){
            BankAccount b1 = new BankAccount();
            BankAccount b2 = new BankAccount();
            
            b1.SetData("ABC",20000);
            b1.Deposit(2000);
            b2.SetData("BCD",30000);
            b2.Withdraw(40000);
            
        }
    }
}



